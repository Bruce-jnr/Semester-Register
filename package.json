{
  "name": "registra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names WEB,API --prefix-colors cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "npm --prefix server run dev",
    "start": "node startup.cjs",
    "seed": "npm --prefix server run seed",
    "dev:web": "vite",
    "migrate:accommodation": "node server/config/migrate-accommodation.js",
    "test:accommodation": "node --test server/tests/accommodation.test.cjs",
    "migrate:uniform-fee": "node server/config/migrate-uniform-fee.js",
    "test:uniform-fee": "node --test server/tests/uniform-fee.test.cjs",
    "test:startup": "node --test server/tests/listen.test.cjs",
    "install:server": "npm --prefix server install --omit=dev",
    "test:room-filter": "node --test server/tests/room-filter.test.cjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
