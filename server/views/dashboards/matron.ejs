<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matron Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Matron Dashboard</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/api/auth/logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="mb-4">Registered Students (View Only)</h2>
        <p class="text-muted">You have view-only access to the student registration list.</p>
        
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-12">
                <h4 class="mb-3">Student Statistics</h4>
                <div class="row" id="studentStatsContainer">
                    <!-- Student stats will be loaded here -->
                </div>
            </div>
        </div>

        <!-- All Students -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">All Students</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="searchInput" placeholder="Search students by name, program, or email...">
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Index Number</th>
                                <th>Name</th>
                                <th>Gender</th>
                                <th>Level</th>
                                <th>Phone</th>
                                <th>Room</th>
                                <th>Status</th>
                                <th>Registered Date</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTable">
                            <!-- Students will be loaded here -->
                        </tbody>
                    </table>
                </div>
                <div id="paginationContainer" class="mt-3">
                    <!-- Pagination will be loaded here -->
                </div>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/matron-view.js"></script>
</body>
</html>

