<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accountant Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Accountant Dashboard</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/api/auth/logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div id="alertMessage"></div>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Fee Payment Records</h2>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#feePaymentModal">
                <i class="fas fa-plus-circle me-1"></i>Record Fee Payment
            </button>
        </div>
        
        <!-- Statistics Cards -->
        <div class="row mb-4" id="statsContainer">
            <!-- Stats will be loaded here -->
        </div>

        <!-- All Fee Payments Table -->
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">All Fee Payments</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="levelFilter" class="form-label">Filter by Level</label>
                        <select class="form-select" id="levelFilter">
                            <option value="">All Levels</option>
                            <!-- Levels will be loaded dynamically -->
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="receiptStatusFilter" class="form-label">Filter by Receipt Status</label>
                        <select class="form-select" id="receiptStatusFilter">
                            <option value="">All Statuses</option>
                            <option value="false">Receipt Pending</option>
                            <option value="true">Receipt Issued</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="paymentMethodFilter" class="form-label">Filter by Payment Method</label>
                        <select class="form-select" id="paymentMethodFilter">
                            <option value="">All Methods</option>
                            <option value="GCB">GCB</option>
                            <option value="CBG">CBG</option>
                            <option value="CBG USSD">CBG USSD</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="searchInput" class="form-label">Search</label>
                        <input type="text" class="form-control" id="searchInput" placeholder="Search by index number, name, or receipt number...">
                    </div>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                        Clear Filters
                    </button>
                    <button type="button" class="btn btn-success btn-sm" onclick="exportToExcel()" title="Export to Excel">
                        <i class="fas fa-file-excel me-1"></i>Export to Excel
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead id="feesTableHeader">
                            <tr>
                                <th>Index Number</th>
                                <th>Student Name</th>
                                <th>Level</th>
                                <th>Amount Paid (GHS)</th>
                                <th>Payment Method</th>
                                <th style="cursor: pointer;" onclick="sortByDatePaid()" title="Click to sort by date">
                                    Date Paid
                                </th>
                                <th>Bank Receipt Number</th>
                                <th>College Receipt Number</th>
                                <th>Receipt Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="feesTable">
                            <!-- Fee payments will be loaded here -->
                        </tbody>
                    </table>
                </div>
                <div id="paginationContainer" class="mt-3">
                    <!-- Pagination will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Print Receipt Confirmation Modal -->
    <div class="modal fade" id="printReceiptConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Print Receipt</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to print this receipt? Once printed, the receipt will be marked as issued and a college receipt number will be generated.</p>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> This action cannot be undone. The receipt status will be permanently changed to "Issued".
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmPrintReceiptBtn">
                        <i class="fas fa-print me-1"></i>Yes, Print Receipt
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Fee Payment Modal -->
    <div class="modal fade" id="feePaymentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Record Fee Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="feePaymentForm">
                        <div class="mb-3">
                            <label class="form-label">Index Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeIndexNumber" name="index_number" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Student Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeStudentName" name="student_name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Level <span class="text-danger">*</span></label>
                            <select class="form-select" id="feeLevel" name="level" required>
                                <option value="">Select level</option>
                                <option value="Level 100">Level 100</option>
                                <option value="Level 200">Level 200</option>
                                <option value="Level 300">Level 300</option>
                                <option value="Level 400">Level 400</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Amount Paid (GHS) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control" id="feeAmount" name="amount_paid" min="0.01" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                            <select class="form-select" id="feePaymentMethod" name="payment_method" required>
                                <option value="">Select payment method</option>
                                <option value="GCB">GCB</option>
                                <option value="CBG">CBG</option>
                                <option value="CBG USSD">CBG USSD</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date Paid <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="feeDatePaid" name="date_paid" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Bank Receipt Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeReceiptNumber" name="receipt_number" required>
                            <small class="form-text text-muted">Enter the receipt number from the bank (GCB, CBG, or CBG USSD)</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitFeePayment()">Record Payment</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/accountant.js"></script>
</body>
</html>

