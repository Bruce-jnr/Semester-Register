<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Receipt - <%= fee.receipt_number %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Times New Roman', serif;
        background: #f5f5f5;
        color: #000;
        padding: 10px;
      }
      .a4 {
        width: 210mm;
        min-height: 297mm;
        max-height: 297mm;
        margin: 20px auto;
        padding: 10mm 15mm;
        border: 1px solid #ddd;
        background: #fff;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 3mm;
        overflow: hidden;
      }
      .receipt-copy {
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        border: 1px dashed #ccc;
        position: relative;
        box-sizing: border-box;
        overflow: hidden;
      }
      .header-logo {
        width: 80px;
        height: 80px;
        display: inline-block;
        text-align: center;
        vertical-align: middle;
      }
      .header-logo img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }
      .letter-head {
        text-align: center;
        margin-bottom: 10px;
      }
      .receipt-title {
        font-size: 16px;
        font-weight: bold;
        margin: 10px 0 8px 0;
        text-align: center;
        text-decoration: underline;
      }
      .receipt-info {
        margin: 8px 0;
        line-height: 1.4;
      }
      .receipt-info p {
        margin-bottom: 4px;
        font-size: 11px;
      }
      .receipt-table {
        width: 100%;
        margin: 10px 5px;
        border-collapse: collapse;
        font-size: 10px;
      }
      .receipt-table th,
      .receipt-table td {
        padding: 4px 6px;
        border: 1px solid #000;
        text-align: left;
        font-size: 10px;
      }
      .receipt-table th {
        background-color: #f0f0f0;
        font-weight: bold;
      }
      .receipt-table .amount-cell {
        text-align: right;
        font-weight: bold;
      }
      .footer-section {
        margin-top: 15px;
      }
      .footer-section p {
        margin-bottom: 2px;
        font-size: 10px;
      }
    
     
      .copy-label {
        position: absolute;
        top: 5mm;
        right: 5mm;
        font-weight: bold;
        font-size: 10px;
        padding: 3px 8px;
        border: 1px solid #000;
        background: #fff;
      }
      .no-print {
        text-align: center;
        margin-bottom: 20px;
      }
      .heading {
        color: #0066cc;
      }

      /* Print styles for A4 */
      @media print {
        body {
          margin: 0;
          padding: 0;
          background: #fff;
        }
        .no-print {
          display: none !important;
        }
        .a4 {
          width: 210mm;
          height: 297mm;
          margin: 0;
          padding: 5mm;
          border: none;
          box-shadow: none;
          page-break-after: avoid;
          page-break-inside: avoid;
          overflow: hidden;
        }
        .receipt-copy {
          border: 1px dashed #000;
          page-break-inside: avoid;
          page-break-after: avoid;
          flex-shrink: 1;
        }
        .receipt-copy:first-child {
          page-break-after: avoid;
        }
      }
    </style>
  </head>
  <body>
    <!-- Print Controls -->
    <div class="no-print text-center mb-3">
      <button onclick="window.print()" class="btn btn-primary me-2">
        <i class="fas fa-print me-1"></i>Print Receipt
      </button>
      <button onclick="window.close()" class="btn btn-secondary">
        <i class="fas fa-times me-1"></i>Close
      </button>
    </div>

    <!-- Single A4 Sheet with Both Copies -->
    <div class="a4">
      <!-- STUDENT COPY -->
      <div class="receipt-copy" style="position: relative; border: 1px solid #000; padding: 5mm;">
        <div class="copy-label">STUDENT COPY</div>
    
        <!-- Letterhead -->
        <div class="letter-head">
          <div class="text-center mb-2">
            <h2 class="fw-bold mb-0 heading" style="font-size: 14px;">
              NSAWKAW COLLEGE OF EDUCATION
            </h2>
            <p class="mb-0 text-danger" style="font-size: 10px;">
              (AFFILIATED TO THE UNIVERSITY OF CAPE COAST - UCC)
            </p>
          </div>
          <div class="row text-center mb-1" style="font-size: 9px;">
            <div class="col-4 text-start">
              <p class="mb-0">TEL: +233(0) 507970090</p>
              <p class="mb-0">EMAIL: info@nsacoe.edu.gh</p>
            </div>
            <div class="col-4 text-center">
              <div class="header-logo mx-auto">
                <img src="/images/logo.jpg" alt="NSACOE Logo" onerror="this.style.display='none';" />
              </div>
            </div>
            <div class="col-4 text-end">
              <p class="mb-0">POST OFFICE BOX 1</p>
              <p class="mb-0">NSAWKAW-TAIN DISTRICT</p>
              <p class="mb-0">BONO REGION</p>
            </div>
          </div>
          <hr style="border-top: 1px solid #000; margin: 5px 0;" />
        </div>
    
        <div class="receipt-title">PAYMENT RECEIPT</div>
    
        <div class="receipt-info">
          <p><strong>College Receipt Number:</strong> <%= fee.college_receipt_number || 'Pending' %></p>
          <p><strong>Bank Receipt Number:</strong> <%= fee.receipt_number %></p>
          <p><strong>Date Issued:</strong> <%= receiptIssuedDate %></p>
        </div>
    
        <table class="receipt-table">
          <tr><th>Student Details</th><th></th></tr>
          <tr><td><strong>Index Number:</strong></td><td><%= fee.index_number %></td></tr>
          <tr><td><strong>Student Name:</strong></td><td><%= fee.student_name %></td></tr>
          <tr><td><strong>Amount Paid:</strong></td><td class="amount-cell">GHS <%= parseFloat(fee.amount_paid).toFixed(2) %></td></tr>
          <tr><td><strong>Payment Method:</strong></td><td><%= fee.payment_method %></td></tr>
          <tr><td><strong>Date Paid:</strong></td><td><%= datePaid %></td></tr>
        </table>
    
        <div class="receipt-info mt-4">
          <p><strong>Amount in Words:</strong> <span id="amountInWords"></span></p>
        </div>
    
        <div class="footer-section">
          <p class="mb-2"><strong>Thank you for your payment!</strong></p>
          <p class="small mb-0">This is a computer-generated receipt. No signature required.</p>
        </div>
      </div>
    
      <!-- Short dashed line between copies -->
      <hr style="border-top: 1px dashed #000; margin: 2mm 0;" />
    
      <!-- ACCOUNT COPY -->
      <div class="receipt-copy" style="position: relative; border: 1px solid #000; padding: 5mm;">
        <div class="copy-label">ACCOUNT COPY</div>
    
        <!-- (Duplicate the same content as above but using amountInWords2 span) -->
        <div class="letter-head">
          <div class="text-center mb-2">
            <h2 class="fw-bold mb-0 heading" style="font-size: 14px;">
              NSAWKAW COLLEGE OF EDUCATION
            </h2>
            <p class="mb-0 text-danger" style="font-size: 10px;">
              (AFFILIATED TO THE UNIVERSITY OF CAPE COAST - UCC)
            </p>
          </div>
          <div class="row text-center mb-1" style="font-size: 9px;">
            <div class="col-4 text-start">
              <p class="mb-0">TEL: +233(0) 507970090</p>
              <p class="mb-0">EMAIL: info@nsacoe.edu.gh</p>
            </div>
            <div class="col-4 text-center">
              <div class="header-logo mx-auto">
                <img src="/images/logo.jpg" alt="NSACOE Logo" onerror="this.style.display='none';" />
              </div>
            </div>
            <div class="col-4 text-end">
              <p class="mb-0">POST OFFICE BOX 1</p>
              <p class="mb-0">NSAWKAW-TAIN DISTRICT</p>
              <p class="mb-0">BONO REGION</p>
            </div>
          </div>
          <hr style="border-top: 1px solid #000; margin: 5px 0;" />
        </div>
    
        <div class="receipt-title">PAYMENT RECEIPT</div>
    
        <div class="receipt-info">
          <p><strong>College Receipt Number:</strong> <%= fee.college_receipt_number || 'Pending' %></p>
          <p><strong>Bank Receipt Number:</strong> <%= fee.receipt_number %></p>
          <p><strong>Date Issued:</strong> <%= receiptIssuedDate %></p>
        </div>
    
        <table class="receipt-table">
          <tr><th>Student Details</th><th></th></tr>
          <tr><td><strong>Index Number:</strong></td><td><%= fee.index_number %></td></tr>
          <tr><td><strong>Student Name:</strong></td><td><%= fee.student_name %></td></tr>
          <tr><td><strong>Amount Paid:</strong></td><td class="amount-cell">GHS <%= parseFloat(fee.amount_paid).toFixed(2) %></td></tr>
          <tr><td><strong>Payment Method:</strong></td><td><%= fee.payment_method %></td></tr>
          <tr><td><strong>Date Paid:</strong></td><td><%= datePaid %></td></tr>
        </table>
    
        <div class="receipt-info mt-4">
          <p><strong>Amount in Words:</strong> <span id="amountInWords2"></span></p>
        </div>
    
        <div class="footer-section">
          <p class="mb-2"><strong>Thank you for your payment!</strong></p>
          <p class="small mb-0">This is a computer-generated receipt. No signature required.</p>
        </div>
      </div>
    </div>
    

    <script>
      // Function to convert number to words
      function numberToWords(num) {
        const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 
                     'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 
                     'Seventeen', 'Eighteen', 'Nineteen'];
        const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
        
        if (num === 0) return 'Zero';
        if (num < 20) return ones[num];
        if (num < 100) {
          const ten = Math.floor(num / 10);
          const one = num % 10;
          return tens[ten] + (one > 0 ? ' ' + ones[one] : '');
        }
        if (num < 1000) {
          const hundred = Math.floor(num / 100);
          const remainder = num % 100;
          return ones[hundred] + ' Hundred' + (remainder > 0 ? ' ' + numberToWords(remainder) : '');
        }
        if (num < 1000000) {
          const thousand = Math.floor(num / 1000);
          const remainder = num % 1000;
          return numberToWords(thousand) + ' Thousand' + (remainder > 0 ? ' ' + numberToWords(remainder) : '');
        }
        return 'Number too large';
      }

      // Convert amount to words
      const amount = parseFloat('<%= fee.amount_paid %>');
      const wholePart = Math.floor(amount);
      const decimalPart = Math.round((amount - wholePart) * 100);
      
      let words = numberToWords(wholePart) + ' Ghana Cedis';
      if (decimalPart > 0) {
        words += ' and ' + numberToWords(decimalPart) + ' Pesewas';
      } else {
        words += ' Only';
      }
      
      document.getElementById('amountInWords').textContent = words;
      document.getElementById('amountInWords2').textContent = words;
    </script>
  </body>
</html>
