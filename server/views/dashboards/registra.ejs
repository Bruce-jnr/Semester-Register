<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Registrar Dashboard</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/api/auth/logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div id="alertMessage"></div>
        <h2 class="mb-4">Overview - All Students & Rooms Management</h2>
        
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h4 class="mb-3">Student Statistics</h4>
                <div class="row" id="studentStatsContainer">
                    <!-- Student stats will be loaded here -->
                </div>
            </div>
            <div class="col-md-6">
                <h4 class="mb-3">Room Statistics</h4>
                <div class="row" id="roomStatsContainer">
                    <!-- Room stats will be loaded here -->
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <a href="/register" class="btn btn-success me-2">
                            <i class="bi bi-person-plus"></i> Register New Student
                        </a>
                        <a href="/rooms" class="btn btn-info me-2">
                            <i class="bi bi-door-open"></i> Manage Rooms
                        </a>
                        <button type="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#feePaymentModal">
                            <i class="bi bi-cash-coin"></i> Record Fee Payment
                        </button>
                        <button type="button" class="btn btn-warning me-2" data-bs-toggle="modal" data-bs-target="#passwordResetModal">
                            <i class="bi bi-key"></i> Manage Passwords
                        </button>
                        <a href="/dashboard/registra/male-students" class="btn btn-secondary me-2">
                            <i class="bi bi-gender-male"></i> View Male Students
                        </a>
                        <a href="/dashboard/registra/female-students" class="btn btn-secondary">
                            <i class="bi bi-gender-female"></i> View Female Students
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- All Students -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">All Registered Students</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="genderFilter" class="form-label">Filter by Gender</label>
                        <select class="form-select" id="genderFilter">
                            <option value="">All Genders</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="levelFilter" class="form-label">Filter by Level</label>
                        <select class="form-select" id="levelFilter">
                            <option value="">All Levels</option>
                            <!-- Levels will be loaded dynamically -->
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="searchInput" class="form-label">Search</label>
                        <input type="text" class="form-control" id="searchInput" placeholder="Search by index number or name">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                            Clear Filters
                        </button>
                    </div>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <div></div>
                    <button type="button" class="btn btn-success btn-sm" onclick="exportToExcel()" title="Export to Excel">
                        <i class="fas fa-file-excel me-1"></i>Export to Excel
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Index Number</th>
                                <th>Name</th>
                                <th>Gender</th>
                              
                                <th>Level</th>
                                <th>Phone</th>
                              
                                <th>Room</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTable">
                            <!-- Students will be loaded here -->
                        </tbody>
                    </table>
                </div>
                <div id="paginationContainer" class="mt-3">
                    <!-- Pagination will be loaded here -->
                </div>
            </div>
        </div>

        <!-- All Rooms -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">All Rooms Status</h5>
            </div>
            <div class="card-body">
                <div class="row" id="roomsContainer">
                    <!-- Rooms will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Allocation Modal -->
    <div class="modal fade" id="allocationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Allocate Room to Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="allocationForm">
                        <input type="hidden" id="studentId" name="studentId">
                        <div class="mb-3">
                            <label class="form-label">Student</label>
                            <input type="text" class="form-control" id="studentName" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Select Room</label>
                            <select class="form-select" id="roomSelect" name="roomId" required>
                                <option value="">Select a room</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitAllocation()">Allocate</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Fee Payment Modal -->
    <div class="modal fade" id="feePaymentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Record Fee Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="feePaymentForm">
                        <div class="mb-3">
                            <label class="form-label">Index Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeIndexNumber" name="index_number" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Student Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeStudentName" name="student_name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Level <span class="text-danger">*</span></label>
                            <select class="form-select" id="feeLevel" name="level" required>
                                <option value="">Select level</option>
                                <option value="Level 100">Level 100</option>
                                <option value="Level 200">Level 200</option>
                                <option value="Level 300">Level 300</option>
                                <option value="Level 400">Level 400</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Amount Paid (GHS) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control" id="feeAmount" name="amount_paid" min="0.01" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                            <select class="form-select" id="feePaymentMethod" name="payment_method" required>
                                <option value="">Select payment method</option>
                                <option value="GCB">GCB</option>
                                <option value="CBG">CBG</option>
                                <option value="CBG USSD">CBG USSD</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date Paid <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="feeDatePaid" name="date_paid" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Receipt Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeReceiptNumber" name="receipt_number" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitFeePayment()">Record Payment</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Password Reset Modal -->
    <div class="modal fade" id="passwordResetModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Admin Passwords</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Admin</label>
                        <select class="form-select" id="adminSelect" onchange="onAdminSelectChange()">
                            <option value="">Select an admin...</option>
                            <!-- Admins will be loaded dynamically -->
                        </select>
                    </div>
                    <form id="passwordResetForm">
                        <input type="hidden" id="selectedAdminId" value="">
                        <div id="currentPasswordContainer" class="mb-3" style="display: none;">
                            <label class="form-label">Current Password <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="currentPassword" placeholder="Enter your current password">
                            <small class="text-muted">Required when resetting your own password</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New Password <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="newPassword" placeholder="Enter new password (minimum 6 characters)" minlength="6" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm New Password <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="confirmPassword" placeholder="Confirm new password" minlength="6" required>
                        </div>
                    </form>
                    <div id="passwordResetAlert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitPasswordReset()">Reset Password</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Pass current user info to JavaScript
        window.currentUserId = <%= user.id %>;
        window.currentUserRole = '<%= user.role %>';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/registra.js"></script>
</body>
</html>

